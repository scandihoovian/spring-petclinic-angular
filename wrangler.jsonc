// Cloudflare Workers static-assets deployment of the production build.
// Build and deploy with: npm run deploy:cloudflare
{
  "name": "spring-petclinic-angular",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/browser",
    // Serve index.html for client-side routes like /owners/1
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "petclinic.scandihoovian.net", "custom_domain": true }
  ]
}
